@using GymFlow.WebUI.ViewModels.MemberAttendance
@model MemberAttendanceIndexVM

<form method="get" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">

            <!-- ========================== Date  ========================== -->
            <div class="col-md-3">
                <label asp-for="Filter.Date" class="form-label">
                    @Localizer["Date"]
                </label>

                <input asp-for="Filter.Date"
                       class="form-control"
                       id="attendanceDate"
                       type="date"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>

            <!-- ========================== Search ========================== -->
            <div class="col-md-3">
                <label asp-for="Filter.Search" class="form-label">
                    @Localizer["Search"]
                </label>

                <input asp-for="Filter.Search"
                       class="form-control"
                       placeholder="@Localizer["Search"]" />
            </div>


            <!-- ========================== Attendance Status ========================== -->
            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Filter.HasAttendance" class="form-label">
                    @Localizer["HasAttendance"]
                </label>

                <select asp-for="Filter.HasAttendance"
                        class="form-select">

                    <option value="">
                        @Localizer["All"]
                    </option>

                    <option value="true">
                        @* @Localizer["Yes"] *@
                        @Localizer["Attended"]
                    </option>

                    <option value="false">
                        @* @Localizer["No"] *@
                        @Localizer["NotAttended"]
                    </option>

                </select>
            </div>


            <!-- ========================== Actions ========================== -->
            <div class="col-auto">
                <button type="submit"
                        class="btn btn-primary">

                    <i class="fa fa-search me-1"></i>
                    @Localizer["Search"]

                </button>
            </div>


            <div class="col-auto">
                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="fa fa-times me-1"></i>
                    @Localizer["Clear"]

                </a>
            </div>

        </div>
    </div>
</form>