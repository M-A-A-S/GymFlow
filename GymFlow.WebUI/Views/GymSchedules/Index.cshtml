@using GymFlow.WebUI.ViewModels.GymSchedule
@using GymFlow.WebUI.ViewModels.Pagination
@model GymScheduleIndexVM

@using GymFlow.Domain.Enums
@using GymFlow.Domain.Extensions
@using GymFlow.Domain.Resources.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer


@{

    var routes = Model.Filter.ToRouteDictionary();

    var pagination = new PaginationVM
    {
        PageNumber = Model.PagedResult.PageNumber,
        PageSize = Model.PagedResult.PageSize,
        TotalPages = Model.PagedResult.TotalPages,
        TotalCount = Model.PagedResult.TotalCount,
        RouteValues = routes

    };
}

<div class="d-flex align-items-center justify-content-between my-4">
    <h2>@Localizer["GymSchedules"]</h2>

    <a asp-action="Create" class="btn btn-primary">
        <i class="fa fa-plus me-1"></i>
        @Localizer["CreateNew"]
    </a>
</div>

<partial name="Partials/_GymScheduleFilter" />

<partial name="_Pagination"
         model="pagination" />

<partial name="Partials/_GymScheduleTable" />

<partial name="_Pagination"
         model="pagination" />