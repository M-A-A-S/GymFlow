@using GymFlow.WebUI.ViewModels.Pagination
@using GymFlow.WebUI.ViewModels.TrainerSchedule
@model TrainerScheduleIndexVM

@using GymFlow.Domain.Extensions
@using GymFlow.Domain.Resources.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@using System.Globalization

@{

    var routes = Model.Filter.ToRouteDictionary();

    var pagination = new PaginationVM
    {
        PageNumber = Model.PagedResult.PageNumber,
        PageSize = Model.PagedResult.PageSize,
        TotalPages = Model.PagedResult.TotalPages,
        TotalCount = Model.PagedResult.TotalCount,
        RouteValues = routes

    };
}

<div class="d-flex align-items-center justify-content-between my-4">
    <h2>@Localizer["TrainerSchedules"]</h2>

    <a asp-action="Create" class="btn btn-primary">
        <i class="fa fa-plus me-1"></i>
        @Localizer["CreateNew"]
    </a>
</div>

<partial name="Partials/_TrainerScheduleFilter" />

<partial name="_Pagination"
         model="pagination" />

<partial name="Partials/_TrainerScheduleTable" />

<partial name="_Pagination"
         model="pagination" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $("#TrainerId").select2({
            width: "100%",
            allowClear: true,
        });

    </script>
}