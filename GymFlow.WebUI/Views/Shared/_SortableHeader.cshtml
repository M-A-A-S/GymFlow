@using GymFlow.WebUI.Extensions
@using GymFlow.WebUI.ViewModels.Pagination
@model SortHeaderVM


@{
    var routes = new Dictionary<string, string>(Model.Routes);

    routes["SortBy"] = Model.Column;


    routes["Descending"] =
        Model.Filter.ToggleDescending(Model.Column)
        .ToString();


    // Always go back to page 1 after sorting
    routes["PageNumber"] = "1";

}


<a asp-action="Index"
   asp-all-route-data="routes">

    @Model.Title


    <i class="fa-solid
        @Model.Filter.GetSortIcon(Model.Column)
        ms-1">
    </i>

</a>