@using GymFlow.Domain.Extensions
@using GymFlow.WebUI.ViewModels
@using GymFlow.WebUI.ViewModels.MemberSubscription
@using GymFlow.WebUI.ViewModels.Pagination

@model MemberSubscriptionIndexVM

@using System.Globalization
@using GymFlow.Domain.Resources.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    var routes = Model.Filter.ToRouteDictionary();
}

@if (!Model.PagedResult.Items.Any())
{
    <div class="alert alert-info">
        @Localizer["NoRecordsFound"]
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>
                        <partial name="_SortableHeader"
                                 model='new SortHeaderVM
                                 {
                                     Column = "Member",
                                     Title = Localizer["Member"],
                                     Filter = Model.Filter,
                                     Routes = routes
                                 }' />
</th>
                    <th>
                        <partial name="_SortableHeader"
                                 model='new SortHeaderVM
                                 {
                                     Column = "SubscriptionType",
                                     Title = Localizer["SubscriptionType"],
                                     Filter = Model.Filter,
                                     Routes = routes
                                 }' />
</th>
                    <th>
                        <partial name="_SortableHeader"
                                 model='new SortHeaderVM
                                 {
                                     Column = "StartDate",
                                     Title = Localizer["StartDate"],
                                     Filter = Model.Filter,
                                     Routes = routes
                                 }' />
</th>
                    <th>
                        <partial name="_SortableHeader"
                                 model='new SortHeaderVM
                                 {
                                     Column = "EndDate",
                                     Title = Localizer["EndDate"],
                                     Filter = Model.Filter,
                                     Routes = routes
                                 }' />
</th>
                    <th>
                        <partial name="_SortableHeader"
                                 model='new SortHeaderVM
                                 {
                                     Column = "Price",
                                     Title = Localizer["Price"],
                                     Filter = Model.Filter,
                                     Routes = routes
                                 }' />
</th>
                    <th>
                        <partial name="_SortableHeader"
                                 model='new SortHeaderVM
                                 {
                                     Column = "Status",
                                     Title = Localizer["SubscriptionStatus"],
                                     Filter = Model.Filter,
                                     Routes = routes
                                 }' />
</th>
                    <th>
                        <partial name="_SortableHeader"
                                 model='new SortHeaderVM
                                 {
                                     Column = "ActualDurationDays",
                                     Title = Localizer["ActualDurationDays"],
                                     Filter = Model.Filter,
                                     Routes = routes
                                 }' />
</th>
                    <th>
                        <partial name="_SortableHeader"
                                 model='new SortHeaderVM
                                 {
                                     Column = "RemainingDays",
                                     Title = Localizer["RemainingDays"],
                                     Filter = Model.Filter,
                                     Routes = routes
                                 }' />
</th>
                    <th>
                        <partial name="_SortableHeader"
                                 model='new SortHeaderVM
                                 {
                                     Column = "AttendanceDays",
                                     Title = Localizer["AttendanceDays"],
                                     Filter = Model.Filter,
                                     Routes = routes
                                 }' />
</th>
                    <th>
                        <partial name="_SortableHeader"
                                 model='new SortHeaderVM
                                 {
                                     Column = "LastAttendanceDate",
                                     Title = Localizer["LastAttendanceDate"],
                                     Filter = Model.Filter,
                                     Routes = routes
                                 }' />
</th>
                    <th>
                        <partial name="_SortableHeader"
                                 model='new SortHeaderVM
                                 {
                                     Column = "TimeStatus",
                                     Title = Localizer["SubscriptionState"],
                                     Filter = Model.Filter,
                                     Routes = routes
                                 }' />
</th>
                    <th>
                        @Localizer["Actions"]
                    </th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.PagedResult.Items)
                {
                    <tr>
                        <td>
                            @item.Member?.FullName
                        </td>

                        <td>
                            @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
                                ? item.SubscriptionType?.NameAr
                                : item.SubscriptionType?.NameEn)
                        </td>

                        <td>
                            @item.StartDate
                        </td>

                        <td>
                            @item.EndDate
                        </td>

                        <td>
                            @item.Price
                        </td>

                        <td>
                            <span class="badge @item.Status.ToBadgeClass()">
                                @item.Status.ToLocalizedString()
                            </span>
                        </td>

                        <td>
                            @item.ActualDurationDays
                        </td>

                        <td>
                            @item.RemainingDays
                        </td>

                        <td>
                            @item.AttendanceDays
                        </td>

                        <td>
                            @item.LastAttendanceDate
                        </td>

                        <td>
                            <span class="badge @item.TimeStatus.ToBadgeClass()">
                                @Localizer[item.TimeStatus.ToString()]
                            </span>
                        </td>

                        <td class="d-flex align-items-center gap-1">
                            <partial name="_Actions"
                                     model='new ActionButtonsVM
                                     {
                                         Controller = "MemberSubscriptions",
                                         Id = item.Id
                                     }' />
</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}