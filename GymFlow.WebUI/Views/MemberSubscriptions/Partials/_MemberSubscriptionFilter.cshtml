@using System.Globalization
@using GymFlow.Domain.DTOs.MemberSubscription
@using GymFlow.Domain.Enums
@using GymFlow.Domain.Resources.Shared
@using GymFlow.WebUI.ViewModels.MemberSubscription
@using Microsoft.Extensions.Localization

@model MemberSubscriptionIndexVM

@inject IStringLocalizer<SharedResource> Localizer


<form method="get" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">

            <!-- ========================== Search ========================== -->
            <div class="col-12 col-md-6 col-lg-3">
                <label asp-for="Filter.Search" class="form-label">
                    @Localizer["Search"]
                </label>

                <input asp-for="Filter.Search"
                       class="form-control"
                       placeholder="@Localizer["Search"]" />
            </div>


            <!-- ========================== Status ========================== -->
            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Filter.Status" class="form-label">
                    @Localizer["SubscriptionStatus"]
                </label>

                <select asp-for="Filter.Status"
                        asp-items="Html.GetEnumSelectList<SubscriptionStatus>()"
                        class="form-select">

                    <option value="">
                        @Localizer["All"]
                    </option>

                </select>
            </div>

            <!-- ========================== Status ========================== -->
            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Filter.TimeStatus" class="form-label">
                    @Localizer["SubscriptionState"]
                </label>

                <select asp-for="Filter.TimeStatus"
                        asp-items="Html.GetEnumSelectList<SubscriptionTimeStatus>()"
                        class="form-select">

                    <option value="">
                        @Localizer["All"]
                    </option>

                </select>
            </div>


            <!-- ========================== Expiring Soon ========================== -->
            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Filter.ExpiringSoon" class="form-label">
                    @Localizer["ExpiringSoon"]
                </label>

                <select asp-for="Filter.ExpiringSoon"
                        class="form-select">

                    <option value="">
                        @Localizer["All"]
                    </option>

                    <option value="true">
                        @Localizer["Yes"]
                    </option>

                    <option value="false">
                        @Localizer["No"]
                    </option>

                </select>
            </div>


            <!-- ========================== Member ========================== -->
            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Filter.MemberId" class="form-label">
                    @Localizer["Member"]
                </label>

                <select asp-for="Filter.MemberId" id="MemberId"
                        @* asp-items="ViewBag.Members" *@
                        class="form-select"> 

                    <option value="">
                        @Localizer["All"]
                    </option>
                @foreach (var member in Model.Members)
                {
                    <option value="@member.Id">
                                        @member.FullName
                    </option>
                }

                </select>
            </div>


            <!-- ========================== Subscription Type ========================== -->
            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Filter.SubscriptionTypeId" class="form-label">
                    @Localizer["SubscriptionType"]
                </label>

                <select asp-for="Filter.SubscriptionTypeId"
                        id="SubscriptionTypeId"
                        @* asp-items="ViewBag.SubscriptionTypes" *@
                        class="form-select">


                    <option value="">
                        @Localizer["All"]
                    </option>

                    @foreach (var subscriptionTypes in Model.SubscriptionTypes)
                    {
                        <option value="@subscriptionTypes.Id">
                            @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
                                            ? subscriptionTypes?.NameAr
                                            : subscriptionTypes?.NameEn)
                        </option>
                    }

                </select>
            </div>


            <!-- ========================== Start Date ========================== -->
            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Filter.StartDateFrom" class="form-label">
                    @Localizer["StartDateFrom"]
                </label>

                <input asp-for="Filter.StartDateFrom"
                       type="date"
                       class="form-control" />
            </div>


            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Filter.StartDateTo" class="form-label">
                    @Localizer["StartDateTo"]
                </label>

                <input asp-for="Filter.StartDateTo"
                       type="date"
                       class="form-control" />
            </div>


            <!-- ========================== End Date ========================== -->
            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Filter.EndDateFrom" class="form-label">
                    @Localizer["EndDateFrom"]
                </label>

                <input asp-for="Filter.EndDateFrom"
                       type="date"
                       class="form-control" />
            </div>


            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Filter.EndDateTo" class="form-label">
                    @Localizer["EndDateTo"]
                </label>

                <input asp-for="Filter.EndDateTo"
                       type="date"
                       class="form-control" />
            </div>


            <!-- ========================== Price ========================== -->
            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Filter.MinPrice" class="form-label">
                    @Localizer["MinPrice"]
                </label>

                <input asp-for="Filter.MinPrice"
                       type="number"
                       step="0.01"
                       class="form-control" />
            </div>


            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Filter.MaxPrice" class="form-label">
                    @Localizer["MaxPrice"]
                </label>

                <input asp-for="Filter.MaxPrice"
                       type="number"
                       step="0.01"
                       class="form-control" />
            </div>


            <!-- ========================== Duration ========================== -->
            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Filter.MinDurationDays" class="form-label">
                    @Localizer["MinDurationDays"]
                </label>

                <input asp-for="Filter.MinDurationDays"
                       type="number"
                       class="form-control" />
            </div>


            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Filter.MaxDurationDays" class="form-label">
                    @Localizer["MaxDurationDays"]
                </label>

                <input asp-for="Filter.MaxDurationDays"
                       type="number"
                       class="form-control" />
            </div>


            <!-- ========================== Remaining Days ========================== -->
            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Filter.MinRemainingDays" class="form-label">
                    @Localizer["MinRemainingDays"]
                </label>

                <input asp-for="Filter.MinRemainingDays"
                       type="number"
                       class="form-control" />
            </div>


            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Filter.MaxRemainingDays" class="form-label">
                    @Localizer["MaxRemainingDays"]
                </label>

                <input asp-for="Filter.MaxRemainingDays"
                       type="number"
                       class="form-control" />
            </div>


            <!-- ========================== Attendance ========================== -->
            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Filter.HasAttendance" class="form-label">
                    @Localizer["HasAttendance"]
                </label>

                <select asp-for="Filter.HasAttendance"
                        class="form-select">

                    <option value="">
                        @Localizer["All"]
                    </option>

                    <option value="true">
                        @* @Localizer["Yes"] *@
                        @Localizer["Attended"]
                    </option>

                    <option value="false">
                        @* @Localizer["No"] *@
                        @Localizer["NotAttended"]
                    </option>

                </select>
            </div>


            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Filter.MinAttendanceDays" class="form-label">
                    @Localizer["MinAttendanceDays"]
                </label>

                <input asp-for="Filter.MinAttendanceDays"
                       type="number"
                       class="form-control" />
            </div>


            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Filter.MaxAttendanceDays" class="form-label">
                    @Localizer["MaxAttendanceDays"]
                </label>

                <input asp-for="Filter.MaxAttendanceDays"
                       type="number"
                       class="form-control" />
            </div>


            <!-- ========================== Actions ========================== -->
            <div class="col-auto">
                <button type="submit"
                        class="btn btn-primary">

                    <i class="fa fa-search me-1"></i>
                    @Localizer["Search"]

                </button>
            </div>


            <div class="col-auto">
                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="fa fa-times me-1"></i>
                    @Localizer["Clear"]

                </a>
            </div>

        </div>
    </div>
</form>