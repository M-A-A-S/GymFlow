@using GymFlow.Domain.Enums;
@using GymFlow.WebUI.ViewModels.MemberSubscription
@using GymFlow.WebUI.ViewModels.Pagination


@model MemberSubscriptionIndexVM

@using GymFlow.Domain.Extensions

@using System.Globalization

@{

    var routes = Model.Filter.ToRouteDictionary();

    var pagination = new PaginationVM
    {
        PageNumber = Model.PagedResult.PageNumber,
        PageSize = Model.PagedResult.PageSize,
        TotalPages = Model.PagedResult.TotalPages,
        TotalCount = Model.PagedResult.TotalCount,
        RouteValues = routes

    };
}

<div class="d-flex align-items-center justify-content-between my-4">
    <h2>@Localizer["MemberSubscriptions"]</h2>

    <a asp-action="Create" class="btn btn-primary">
        <i class="fa fa-plus me-1"></i>
        @Localizer["CreateNew"]
    </a>
</div>


<partial name="Partials/_MemberSubscriptionFilter"/>

<partial name="_Pagination"
         model="pagination" />

<partial name="Partials/_MemberSubscriptionTable"/>

<partial name="_Pagination"
         model="pagination" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $("#MemberId").select2({
            width: "100%",
            allowClear: true,
        });
        $("#SubscriptionTypeId").select2({
            width: "100%",
            allowClear: true,
        });

    </script>
}
