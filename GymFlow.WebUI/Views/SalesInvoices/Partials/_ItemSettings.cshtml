@using GymFlow.Domain.DTOs.SalesInvoice
@model SalesInvoiceAddUpdateDTO

@using GymFlow.Domain.Resources.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="itemSettingsOffcanvas"
     aria-labelledby="itemSettingsLabel">

    <div class="offcanvas-header">

        <h5 id="itemSettingsLabel">
            @Localizer["ItemSettings"]
        </h5>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas">
        </button>

    </div>

    <div class="offcanvas-body">

        <form id="frmItemSettings">

            <input type="hidden" id="ItemId" />
            <input type="hidden" id="ItemType" />

            <!-- Loaded dynamically -->
            <div id="itemSettingsContainer"></div>

            <hr />

            <button type="button"
                    class="btn btn-primary w-100"
                    id="btnAddToCart">

                <i class="fa fa-cart-plus"></i>

                @Localizer["AddToCart"]

            </button>

        </form>

    </div>

</div>

<!-- PRODUCT TEMPLATE -->

<script type="text/template" id="productSettingsTemplate">


    <div class="mb-3">

    <label class="form-label">

    @Localizer["Product"]

    </label>


    <input id="ProductName"
           class="form-control"
           readonly />

    </div>



    <div class="mb-3">

    <label class="form-label">

    @Localizer["Price"]

    </label>


    <input id="UnitPrice"
           class="form-control"
           readonly />

    </div>




    <div class="mb-3">

    <label class="form-label">

    @Localizer["Quantity"]

    </label>


    <input id="Quantity"
           type="number"
           class="form-control"
           value="1"
           min="1"/>

    </div>



    <div class="mb-3">

    <label class="form-label">

    @Localizer["Discount"]

    </label>


    <input id="Discount"
           type="number"
           class="form-control"
           value="0"/>

    </div>



    <div class="alert alert-primary">

    @Localizer["Total"] :

    <span id="ProductTotal">
    0
    </span>


    </div>


</script>





<!-- SUBSCRIPTION TEMPLATE -->


<script type="text/template" id="subscriptionSettingsTemplate">


    <div class="mb-3">


    <label class="form-label">

    @Localizer["Subscription"]

    </label>


    <input id="SubscriptionName"
           class="form-control"
           readonly />


    </div>




    <div class="mb-3">


    <label class="form-label">

    @Localizer["Price"]

    </label>


    <input id="SubscriptionPrice"
           class="form-control"
           readonly />


    </div>





    <div class="mb-3">


    <label class="form-label">

    @Localizer["StartDate"]

    </label>


    <input id="StartDate"
           type="date"
           class="form-control"/>


    </div>





    <div class="mb-3">


    <label class="form-label">

    @Localizer["EndDate"]

    </label>


    <input id="EndDate"
           type="date"
           class="form-control"/>


    </div>



    <div class="alert alert-primary">

    @Localizer["Duration"] :

    <span id="SubscriptionDuration">

    </span>

    </div>



</script>

