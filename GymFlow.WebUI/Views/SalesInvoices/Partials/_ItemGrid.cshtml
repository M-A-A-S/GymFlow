@using GymFlow.Domain.DTOs.SalesInvoice
@model SalesInvoiceAddUpdateDTO

@using GymFlow.Domain.Resources.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer


<div class="card shadow-sm border-0 mb-3">

    <div class="card-header">

        <div class="row align-items-center">

            <div class="col-md-6">

                <h5 class="mb-0">

                    <i class="fa fa-box-open me-2"></i>

                    @Localizer["Items"]

                </h5>

            </div>

            <div class="col-md-6">

                <input id="txtItemSearch"
                       class="form-control"
                       placeholder="@Localizer["SearchItems"]" />

            </div>

        </div>

    </div>

    <div class="card-body">

        <div class="row g-3" id="itemContainer">

        </div>

    </div>

</div>


