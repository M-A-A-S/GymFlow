@using GymFlow.Domain.DTOs.SalesInvoice
@using GymFlow.Domain.Resources.Shared
@using Microsoft.Extensions.Localization

@model SalesInvoiceDTO

@inject IStringLocalizer<SharedResource> Localizer


<div class="container-fluid">


    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3>

            <i class="bi bi-receipt-cutoff text-primary"></i>

            @Localizer["SalesInvoiceDetails"]

        </h3>


        <div>

            <a asp-action="Print"
               asp-route-id="@Model.Id"
               target="_blank"
               class="btn btn-primary">

                <i class="fa fa-print"></i>

                @Localizer["Print"]

            </a>


            @* <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                <i class="bi bi-pencil"></i>

                @Localizer["Edit"]

            </a> *@


            <a asp-action="Index"
               class="btn btn-secondary">

                @* <i class="fa fa-arrow-left"></i> *@

                @Localizer["GoBack"]

            </a>

        </div>


    </div>



    <partial name="Partials/Details/_InvoiceHeader"
             model="Model" />



    <partial name="Partials/Details/_MemberCard"
             model="Model" />



    <partial name="Partials/Details/_ItemsTable"
             model="Model" />



    <partial name="Partials/Details/_Payments"
             model="Model" />



    <partial name="Partials/Details/_InvoiceTotals"
             model="Model" />



</div>