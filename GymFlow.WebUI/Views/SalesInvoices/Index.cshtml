@using GymFlow.Domain.DTOs.SalesInvoice
@model IEnumerable<SalesInvoiceDTO>

@using GymFlow.Domain.Extensions
@using GymFlow.Domain.Resources.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer


<div class="d-flex align-items-center justify-content-between my-4">
    <h2>@Localizer["SalesInvoices"]</h2>

    <a asp-action="Create" class="btn btn-primary">
        <i class="fa fa-plus me-1"></i>
        @Localizer["CreateNew"]
    </a>
</div>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>@Localizer["InvoiceNo"]</th>
                <th>@Localizer["Member"]</th>
                <th>@Localizer["InvoiceDate"]</th>
                <th>@Localizer["SubTotal"]</th>
                <th>@Localizer["Discount"]</th>
                <th>@Localizer["Tax"]</th>
                <th>@Localizer["NetAmount"]</th>
                <th>@Localizer["PaidAmount"]</th>
                <th>@Localizer["RemainingBalance"]</th>
                <th>@Localizer["Status"]</th>
                <th>@Localizer["Notes"]</th>
                <th>@Localizer["Actions"]</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {

                <tr>
                    <td>@item.InvoiceNo</td>
                    <td>@item?.Member?.FullName</td>
                    <td>@item.InvoiceDate</td>
                    <td class="fw-bold text-primary">
                        @item.SubTotal.ToString("N2")
                    </td>
                    <td class="fw-bold text-danger">
                        @item.Discount.ToString("N2")
                    </td>
                    <td class="fw-bold text-secondary">
                        @item.Tax.ToString("N2")
                    </td>
                    <td class="fw-bold text-primary">
                        @item.NetAmount.ToString("N2")
                    </td>
                    <td class="fw-bold text-success">
                        @item.PaidAmount.ToString("N2")
                    </td>
                    <td class="fw-bold @(item.RemainingBalance > 0 ? "text-danger" : "text-success")">
                        @item.RemainingBalance.ToString("N2")
                    </td>

                    <td>
                        <span class="badge @item.Status.ToBadgeClass()">
                            @item.Status.ToLocalizedString()
                        </span>
                    </td>
                    <td>@item.Notes</td>
                    <td>
                        @* <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-icon btn-outline-primary tooltip-btn"
                           data-tooltip="@Localizer["Edit"]">
                            <i class="fa fa-pen"></i>
                        </a> *@
                        <a asp-action="Print"
                           asp-route-id="@item.Id"
                           target="_blank"
                           class="btn btn-icon btn-outline-secondary tooltip-btn"
                           data-tooltip="@Localizer["Print"]">

                            <i class="fa fa-print"></i>

                        </a>
                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-icon btn-outline-info tooltip-btn"
                           data-tooltip="@Localizer["Details"]">
                            <i class="fa fa-info"></i>
                        </a>
                        @* <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-icon btn-outline-danger tooltip-btn"
                           data-tooltip="@Localizer["Delete"]">
                            <i class="fa fa-trash"></i>
                        </a> *@
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>