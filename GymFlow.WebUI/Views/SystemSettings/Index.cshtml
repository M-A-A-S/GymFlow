@using GymFlow.WebUI.ViewModels.SystemSetting
@model SystemSettingVM

@using GymFlow.Domain.Resources.Shared
@using GymFlow.WebUI.Extensions
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer




<form asp-action="Edit"
      method="post"
      enctype="multipart/form-data">

    <div class="sticky-save-bar">
        <button type="submit"
                class="btn btn-primary">
            @Localizer["Save"]
        </button>
    </div>

    <input type="hidden" asp-for="Id" />


    <div class="card">

        <div class="card-header">
            <h4>
                @Localizer["CompanyInformation"]
            </h4>
        </div>


        <div class="card-body">


            <div class="row">


                <div class="col-md-6">

                    <label>
                        @Localizer["NameEn"]
                    </label>

                    <input asp-for="NameEn"
                           class="form-control" />

                </div>



                <div class="col-md-6">

                    <label>
                        @Localizer["NameAr"]
                    </label>

                    <input asp-for="NameAr"
                           class="form-control" />

                </div>


            </div>



            <div class="row mt-3">


                <div class="col-md-6">

                    <label>
                        @Localizer["AddressEn"]
                    </label>

                    <input asp-for="AddressEn"
                           class="form-control" />

                </div>



                <div class="col-md-6">

                    <label>
                        @Localizer["AddressAr"]
                    </label>

                    <input asp-for="AddressAr"
                           class="form-control" />

                </div>


            </div>




            <div class="row mt-3">


                <div class="col-md-4">

                    <label>
                        @Localizer["Phone"]
                    </label>

                    <input asp-for="Phone"
                           class="form-control" />

                </div>


                <div class="col-md-4">

                    <label>
                        @Localizer["Email"]
                    </label>

                    <input asp-for="Email"
                           class="form-control" />

                </div>



                <div class="col-md-4">

                    <label>
                        @Localizer["Currency"]
                    </label>

                    <input asp-for="Currency"
                           class="form-control" />

                </div>


            </div>



            <div class="row mt-3">


                <div class="col-md-6">

                    <label>
                        @Localizer["Website"]
                    </label>

                    <input asp-for="Website"
                           class="form-control" />

                </div>



                <div class="col-md-6">

                    <label>
                        @Localizer["TaxNumber"]
                    </label>

                    <input asp-for="TaxNumber"
                           class="form-control" />

                </div>


            </div>

            <div class="row mt-3">
                <partial name="_ImageUpload" model="Model.Image" />
            </div>


        </div>

    </div>




    <div class="card mt-4">

        <div class="card-header">
            <h4>
                @Localizer["ReceiptSettings"]
            </h4>
        </div>


        <div class="card-body">


            <label>
                @Localizer["ReceiptFooterEn"]
            </label>

            <textarea asp-for="ReceiptFooterEn"
                      class="form-control">
        </textarea>



            <label class="mt-3">
                @Localizer["ReceiptFooterAr"]
            </label>

            <textarea asp-for="ReceiptFooterAr"
                      class="form-control">
        </textarea>


        </div>

    </div>






</form>