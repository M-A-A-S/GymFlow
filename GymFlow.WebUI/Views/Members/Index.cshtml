
@using GymFlow.WebUI.ViewModels.Member
@model MemberIndexVM

@using GymFlow.Domain.Enums
@using GymFlow.Domain.Extensions
@using GymFlow.Domain.Resources.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@using System.Globalization

@{
    // fa-sort ↕ This column is not the current sort column.
    //fa-sort-up ↑ Sorted Ascending(A → Z / Old → New)
    //fa-sort-down ↓ Sorted Descending(Z → A / New → Old)

    // var isCurrent = Model.Filter.SortBy == "FullName";
    // string icon;


    // if (Model.Filter.SortBy != "FullName")
    // {
    //     icon = "fa-sort";
    // }
    // else
    // {
    //     icon = Model.Filter.Descending
    //         ? "fa-sort-down"
    //         : "fa-sort-up";
    // }

    string GetSortIcon(string column)
    {
        if (Model.Filter.SortBy != column)
        {
            return "fa-sort";
        }

        return Model.Filter.Descending ? "fa-sort-down" : "fa-sort-up";
    }

    bool IsDescending(string column)
    {
        return Model.Filter.SortBy == column ? !Model.Filter.Descending : false;
    }

}

<div class="d-flex align-items-center justify-content-between my-4">
    <h2>@Localizer["Members"]</h2>

    <a asp-action="Create" class="btn btn-primary">
        <i class="fa fa-plus me-1"></i>
        @Localizer["CreateNew"]
    </a>
</div>

<form method="get" class="card mb-4 shadow-sm">

    <div class="card-body">

        <div class="row g-3 align-items-end">

            <div class="col-12 col-md-6 col-lg-3">

                <label asp-for="Filter.Search" class="form-label">
                    @Localizer["Search"]
                </label>

                <input asp-for="Filter.Search"
                       class="form-control"
                       placeholder="@Localizer["Search"]" />

            </div>

            <div class="col-12 col-sm-6 col-lg-2">

                <label asp-for="Filter.Status" class="form-label">
                    @Localizer["Status"]
                </label>

                <select asp-for="Filter.Status"
                        asp-items="Html.GetEnumSelectList<MemberStatus>()"
                        class="form-select">

                    <option value="">
                        @Localizer["All"]
                    </option>

                </select>

            </div>

            <div class="col-12 col-sm-6 col-lg-2">

                <label asp-for="Filter.Gender" class="form-label">
                    @Localizer["Gender"]
                </label>

                <select asp-for="Filter.Gender"
                        asp-items="Html.GetEnumSelectList<Gender>()"
                        class="form-select">

                    <option value="">
                        @Localizer["All"]
                    </option>

                </select>

            </div>

            <div class="col-12 col-sm-6 col-lg-2">

                <label asp-for="Filter.RegisterDateFrom" class="form-label">
                    @Localizer["FromDate"]
                </label>

                <input asp-for="Filter.RegisterDateFrom"
                       type="date"
                       class="form-control" />

            </div>

            <div class="col-12 col-sm-6 col-lg-2">

                <label asp-for="Filter.RegisterDateTo" class="form-label">
                    @Localizer["ToDate"]
                </label>

                <input asp-for="Filter.RegisterDateTo"
                       type="date"
                       class="form-control" />

            </div>

            <div class="col-12 col-lg-auto">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fa fa-search me-1"></i>

                    @Localizer["Search"]

                </button>

            </div>

            <div class="col-12 col-lg-auto">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="fa fa-times me-1"></i>

                    @Localizer["Clear"]

                </a>

            </div>

        </div>

    </div>

</form>

