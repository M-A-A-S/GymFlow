
@using GymFlow.WebUI.ViewModels.Member
@model MemberIndexVM

@using GymFlow.Domain.Extensions
@using GymFlow.Domain.Resources.Shared
@using GymFlow.WebUI.ViewModels.Pagination
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer



@{

    var routes = Model.Filter.ToRouteDictionary();

    var pagination = new PaginationVM
            {
                PageNumber = Model.Members.PageNumber,
                PageSize = Model.Members.PageSize,
                TotalPages = Model.Members.TotalPages,
                TotalCount = Model.Members.TotalCount,
                RouteValues = routes

            };
}


<div class="d-flex align-items-center justify-content-between my-4">
    <h2>@Localizer["Members"]</h2>

    <a asp-action="Create" class="btn btn-primary">
        <i class="fa fa-plus me-1"></i>
        @Localizer["CreateNew"]
    </a>
</div>

<partial name="Partials/_MemberFilter" />

<partial name="_Pagination"
         model="pagination" />

<partial name="Partials/_MemberTable" />

<partial name="_Pagination"
         model="pagination" />
