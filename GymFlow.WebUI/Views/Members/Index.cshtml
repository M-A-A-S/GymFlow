<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>
                    @* @Localizer["FullName"] *@
                    <a asp-action="Index"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-Status="@Model.Filter.Status"
                       asp-route-RegisterDateFrom="@Model.Filter.RegisterDateFrom"
                       asp-route-RegisterDateTo="@Model.Filter.RegisterDateTo"
                       asp-route-SortBy="FullName"
                       @* asp-route-Descending="@(Model.Filter.SortBy == "FullName" ? !Model.Filter.Descending : false)" *@
                       asp-route-Descending="@IsDescending("FullName")">

                        @Localizer["FullName"]

                        <i class="fa-solid @GetSortIcon("FullName") ms-1"></i>
                        @* @if (isCurrent)
                        {
                        } *@

                    </a>
                </th>
                <th>@Localizer["Gender"]</th>
                <th>
                    @* @Localizer["BirthDate"] *@
                    <a asp-action="Index"
                       asp-route-SortBy="BirthDate"
                       @* asp-route-Descending="@(Model.Filter.SortBy == "BirthDate" ? !Model.Filter.Descending : false)" *@
                       asp-route-Descending="@IsDescending("BirthDate")"
                       asp-route-Search="@Model.Filter.Search">
                        
                        @Localizer["BirthDate"]

                        <i class="fa-solid @GetSortIcon("BirthDate") ms-1"></i>

                    </a>
                </th>
                <th>
                    @* @Localizer["PhoneNumber"] *@
                    <a asp-action="Index"
                       asp-route-SortBy="PhoneNumber"
                       @* asp-route-Descending="@(Model.Filter.SortBy == "PhoneNumber" ? !Model.Filter.Descending : false)" *@
                       asp-route-Descending="@IsDescending("PhoneNumber")"
                       asp-route-Search="@Model.Filter.Search">

                        @Localizer["PhoneNumber"]

                        <i class="fa-solid @GetSortIcon("PhoneNumber") ms-1"></i>

                    </a>
                </th>
                <th>@Localizer["Email"]</th>
                <th>@Localizer["Address"]</th>
                <th>
                    @* @Localizer["RegisterDate"] *@
                    <a asp-action="Index"
                       asp-route-SortBy="RegisterDate"
                       @* asp-route-Descending="@(Model.Filter.SortBy == "RegisterDate" ? !Model.Filter.Descending : false)" *@
                       asp-route-Descending="@IsDescending("RegisterDate")"
                       asp-route-Search="@Model.Filter.Search">

                        @Localizer["RegisterDate"]

                        <i class="fa-solid @GetSortIcon("RegisterDate") ms-1"></i>

                    </a>
                </th>
                <th>
                    @* @Localizer["Status"] *@
                    <a asp-action="Index"
                       asp-route-SortBy="Status"
                       @* asp-route-Descending="@(Model.Filter.SortBy == "Status" ? !Model.Filter.Descending : false)" *@
                       asp-route-Descending="@IsDescending("Status")"
                       asp-route-Search="@Model.Filter.Search">

                        @Localizer["Status"]

                        <i class="fa-solid @GetSortIcon("Status") ms-1"></i>

                    </a>
                </th>
                <th>@Localizer["Actions"]</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.Members.Items)
            {

                <tr>
                    <td>@item.FullName</td>
                    <td>
                        <span class="badge @item.Gender.ToBadgeClass()">
                            @item.Gender.ToLocalizedString()
                        </span>
                    </td>
                    <td>@item.BirthDate</td>
                    <td>@item.PhoneNumber</td>
                    <td>@item.Email</td>
                    <td>@item.Address</td>
                    <td>@item.RegisterDate</td>
                    <td>
                        <span class="badge @item.Status?.ToBadgeClass()">
                            @item.Status?.ToLocalizedString()
                        </span>
                    </td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-icon btn-outline-primary tooltip-btn"
                           data-tooltip="@Localizer["Edit"]">
                            <i class="fa fa-pen"></i>
                        </a>
                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-icon btn-outline-info tooltip-btn"
                           data-tooltip="@Localizer["Details"]">
                            <i class="fa fa-info"></i>
                        </a>
                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-icon btn-outline-danger tooltip-btn"
                           data-tooltip="@Localizer["Delete"]">
                            <i class="fa fa-trash"></i>
                        </a>
                    </td>
                </tr>              
            }
        </tbody>
    </table>
</div>