@using GymFlow.WebUI.ViewModels.Product
@model ProductIndexVM

@{
    bool isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

<form method="get" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">

            <!-- ==================== Search  ==================== -->
            <div class="col-12 col-md-6 col-lg-3">
                <label asp-for="Filter.Search" class="form-label">
                    @Localizer["Search"]
                </label>

                <input asp-for="Filter.Search"
                       class="form-control"
                       placeholder="@Localizer["Search"]" />
            </div>

            <!-- ==================== Category  ==================== -->
            <div class="col-12 col-md-6 col-lg-3">
                <label asp-for="Filter.CategoryId" class="form-label">
                    @Localizer["Category"]
                </label>

                <select asp-for="Filter.CategoryId"
                        class="form-select">

                    <option value="">
                        @Localizer["All"]
                    </option>

                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id">
                            @if (isArabic)
                            {
                                @category.NameAr
                            }
                            else
                            {
                                @category.NameEn
                            }
                        </option>
                    }

                </select>
            </div>

            <!-- ==================== Sale Price  ==================== -->
            <div class="col-6 col-lg-2">
                <label asp-for="Filter.MinSalePrice" class="form-label">
                    @Localizer["MinSalePrice"]
                </label>

                <input asp-for="Filter.MinSalePrice"
                       type="number"
                       step="0.01"
                       class="form-control" />
            </div>

            <div class="col-6 col-lg-2">
                <label asp-for="Filter.MaxSalePrice" class="form-label">
                    @Localizer["MaxSalePrice"]
                </label>

                <input asp-for="Filter.MaxSalePrice"
                       type="number"
                       step="0.01"
                       class="form-control" />
            </div>

            <!-- ==================== Purchase Price  ==================== -->
            <div class="col-6 col-lg-2">
                <label asp-for="Filter.MinPurchasePrice" class="form-label">
                    @Localizer["MinPurchasePrice"]
                </label>

                <input asp-for="Filter.MinPurchasePrice"
                       type="number"
                       step="0.01"
                       class="form-control" />
            </div>

            <div class="col-6 col-lg-2">
                <label asp-for="Filter.MaxPurchasePrice" class="form-label">
                    @Localizer["MaxPurchasePrice"]
                </label>

                <input asp-for="Filter.MaxPurchasePrice"
                       type="number"
                       step="0.01"
                       class="form-control" />
            </div>

            <!-- ==================== Quantity  ==================== -->
            <div class="col-6 col-lg-2">
                <label asp-for="Filter.MinQuantity" class="form-label">
                    @Localizer["MinQuantity"]
                </label>

                <input asp-for="Filter.MinQuantity"
                       type="number"
                       class="form-control" />
            </div>

            <div class="col-6 col-lg-2">
                <label asp-for="Filter.MaxQuantity" class="form-label">
                    @Localizer["MaxQuantity"]
                </label>

                <input asp-for="Filter.MaxQuantity"
                       type="number"
                       class="form-control" />
            </div>

            <!-- ==================== Stock Status  ==================== -->
            <div class="col-6 col-lg-2">

                 <div class="form-check form-switch">
                    <input asp-for="Filter.LowStockOnly"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="Filter.LowStockOnly"
                           class="form-check-label">
                        @Localizer["LowStockOnly"]
                    </label>

                </div>

            </div>

            <div class="col-6 col-lg-2">


                <div class="form-check form-switch">
                    <input asp-for="Filter.OutOfStockOnly"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="Filter.OutOfStockOnly"
                           class="form-check-label">
                        @Localizer["OutOfStockOnly"]
                    </label>

                </div> 

            </div>


            <!-- ==================== Actions  ==================== -->
            <div class="col-auto">
                <button type="submit"
                        class="btn btn-primary">
                    <i class="fa fa-search me-1"></i>
                    @Localizer["Search"]
                </button>
            </div>

            <div class="col-auto">
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    <i class="fa fa-times me-1"></i>
                    @Localizer["Clear"]
                </a>
            </div>

        </div>
    </div>
</form>