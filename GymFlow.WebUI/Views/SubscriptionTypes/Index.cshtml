
@using GymFlow.WebUI.ViewModels.Pagination
@model SubscriptionTypeIndexVM

@using GymFlow.WebUI.ViewModels.SubscriptionType
@using GymFlow.Domain.Extensions;

@{

    var routes = Model.Filter.ToRouteDictionary();

    var pagination = new PaginationVM
    {
        PageNumber = Model.PagedSubscriptionTypeResult.PageNumber,
        PageSize = Model.PagedSubscriptionTypeResult.PageSize,
        TotalPages = Model.PagedSubscriptionTypeResult.TotalPages,
        TotalCount = Model.PagedSubscriptionTypeResult.TotalCount,
        RouteValues = routes

    };
}

<div class="d-flex align-items-center justify-content-between my-4">
    <h2>@Localizer["SubscriptionTypes"]</h2>

    <a asp-action="Create" class="btn btn-primary">
        <i class="fa fa-plus me-1"></i>
        @Localizer["CreateNew"]
    </a>
</div>


<partial name="Partials/_SubscriptionTypeFilter" model="@Model.Filter" />

<partial name="_Pagination"
         model="pagination" />

<partial name="Partials/_SubscriptionTypeTable" />

<partial name="_Pagination"
         model="pagination" />
